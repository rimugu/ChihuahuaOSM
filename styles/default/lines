# -------------------------------------------------------------------
# This is the default mkgmap style file for converting OSM ways
# into Garmin lines.
# Any line prefaced with # is a comment and will not be applied.
# Each line is a rule, of the generalised format:
# OSM_tag(s)_to_match [Garmin_type_code resolution]
# See http://wiki.openstreetmap.org/wiki/Mkgmap/help/style_rules	
# and http://wiki.openstreetmap.org/wiki/Mkgmap/help/Custom_styles
# for more information.

addr:housenumber=* {set mkgmap:execute_finalize_rules=true}

# Assign the street name for house number search
highway=* & name=* {set mkgmap:street='${name}'}
access=yes {set access=public}
barrier=* & is_closed()=true & area_size() < 40000 {delete barrier} # process as areas

name!=* & name:es=* { set name='${name:es}' }
name!=* & name:en=* { set name='${name:en}' }
name!=* & name_1=* { set name='${name_1}' }
name!=* & alt_name=* { set name='${alt_name}' ; delete alt_name}
alt_name!=* & old_name=* { set alt_name='${alt_name}' }
alt_name!=* & official_name=* { set alt_name='${official_name}' }
alt_name!=* & designation=* { set alt_name='${designation}' }


#disused:highway=trunk_link {echotags "disused"}

#surface=sand
#surface=gravel
#surface=unpaved
#surface=dirt
#surface=compacted 
#surface=ground 

abandoned:highway=* & abandoned:highway!=no & is_closed()=false {name '${name} (abandoned) [${abandoned:highway}]' | '(abandoned) [${abandoned:highway}]'} [0x1c resolution 24 ] # continue duplicates path
abandoned=* & abandoned!=no & is_closed()=false {name '${name} (abandoned) [${abandoned}]' | '(abandoned) [${abandoned}]'} [0x1c resolution 24 ]
disused:highway=* & disused:highway!=no & is_closed()=false {name '${name} (disused) [${disused:highway}]' | '(disused) [${disused:highway}]'} [0x1c resolution 24 ]
disused=* & disused!=no & is_closed()=false {name '${name} (disused) [${disused}]' | '(disused) [${disused}]'} [0x1c resolution 24 ]
highway:disused=* & highway:disused!=no & is_closed()=false {name '${name} (disused) [${highway:disused}]' | '(disused) [${highway:disused}]'} [0x1c resolution 24 ]
#abandoned=yes {deletealltags} # old, depreciated, ambiguous, method of handling abandoned
#abandoned=yes {name '${name} (abandoned)' | '(abandoned)'}
#name=* {name '${name} [${ref|highway-symbol:"box:4:8"}|${alt_name}]' | '${name}'}
#location=underground {name '${name} (underground)' | '(underground)'}
# [0x0a continue with_actions]

# do these as lines regardless of being closed unless explicity marked as area. continue in case also a highway
aeroway=runway & area!=yes {name '${ref} [runway]' | '[runway]' ; addlabel '${phone}' | '${website}' | '${operator}'} [0x27 resolution 20-24 continue]
(aeroway=taxiway | aeroway=taxilane) & area!=yes {name '${ref} [taxiway]' | '[taxiway]' ; addlabel '${phone}' | '${website}' | '${operator}'} [0x27 resolution 22-24 continue]
aeroway=airstrip & abandoned=yes {name '${ref} (abandoned) [airstrip]' | '(abandoned) [airstrip]' ; addlabel '${phone}' | '${website}' | '${operator}'} [0x27 resolution 22-24 continue]
aeroway=airstrip {name '${ref} [airstrip]' | '[airstrip]' ; addlabel '${phone}' | '${website}' | '${operator}'} [0x27 resolution 24 continue]

#aerialway=gondola | aerialway=cable_car | aerialway=chair_lift [0x1b resolution 22-24 default_name 'aerialway']
aerialway=gondola | aerialway=cable_car | aerialway=chair_lift {name '${name} (${ref}) [aerialway]' | '${ref} [aerialway]' | '${name} [aerialway]' | '[aerialway]' ; addlabel '${phone}' | '${website}' | '${operator}'} [0x10403 resolution 22-24]
aerialway=zip_line | aerialway=zipline {name '${name} (${ref}) [zipline]' | '${ref} [zipline]' | '${name} [zipline]' | '[zipline]' ; addlabel '${phone}' | '${website}' | '${operator}'} [0x10101 resolution 24]
highway=via_ferrata {name '${name} (${ref}) [via_ferrata]' | '${ref} [via_ferrata]' | '${name} [via_ferrata]' | '[via_ferrata]' ; addlabel '${phone}' | '${website}' | '${operator}'} [0x10101 resolution 24]
highway=piste | highway=ski | piste:difficulty=* | piste:type=* | piste=* {name '${name} (${ref}) [ski]' | '${ref} [ski]' | '${name} [ski]' | '[ski]' ; addlabel '${phone}' | '${website}' | '${operator}'} [0x10101 resolution 24]

# Mark highways with the toll flag
highway=* & (toll=yes | toll=true) {set mkgmap:toll=yes}

#To identify as tunnel labeling, railroad image of things to update

#default for bridge
bridge=* & highway=* & (bridge:structure=suspension | bridge:structure=simple-suspension) { set tempnamebridge='[suspension_bridge]' }
bridge=* & highway=* { set tempnamebridge='[bridge]' }

#extras
bridge=* & highway=* & width=* { set tempnamebridge='(${width}m) ${tempnamebridge}' }
bridge=* & highway=* & surface=* { set tempnamebridge='<${surface}> ${tempnamebridge}' }
bridge=* & highway=* & surface!=* { set tempnamebridge='<unkn> ${tempnamebridge}' } 
if ( bridge=* & highway=* & maxspeed=* & maxspeed ~ '.*mph' ) then
	bridge=* & highway=* & maxspeed=* { set tempnamebridge='(${maxspeed}) ${tempnamebridge}' }
else
	bridge=* & highway=* & maxspeed=* { set tempnamebridge='(${maxspeed} kmh) ${tempnamebridge}' }
end 
bridge=* & highway=* & lanes=* { set tempnamebridge='(${lanes}l) ${tempnamebridge}' } 
bridge=* & highway=* & ref=* { set tempnamebridge='(${ref}) ${tempnamebridge}' }
bridge=* & highway=* & alt_name=* { set tempnamebridge='{${alt_name}} ${tempnamebridge}' }
bridge=* & highway=* & name=* { set tempnamebridge='${name} ${tempnamebridge}' }	#last addition (left most) is name

#bridge=yes & {name '(one_way)'} [0x1050e resolution 24 continue] #arrows
bridge=* & highway=* {name '${tempnamebridge}' ; addlabel '${maxspeed} ${lanes}' | '${maxspeed}' | '${lanes}'} [0x10101 resolution 22 continue with_actions]


#default for tunnel
tunnel=yes { set tunnel=culvert }
tunnel=* & highway=* { set tempnametunnel='(${tunnel}) [tunnel]' }

#extras
tunnel=* & highway=* & width=* { set tempnametunnel='(${tunnel}) ${tempnametunnel}' }
tunnel=* & highway=* & width=* { set tempnametunnel='(${width}m) ${tempnametunnel}' }
tunnel=* & highway=* & surface=* { set tempnametunnel='<${surface}> ${tempnametunnel}' }
tunnel=* & highway=* & surface!=* { set tempnametunnel='<unkn> ${tempnametunnel}' } 
if ( tunnel=* & highway=* & maxspeed=* & maxspeed ~ '.*mph' ) then
	tunnel=* & highway=* & maxspeed=* { set tempnametunnel='(${maxspeed}) ${tempnametunnel}' }
else
	tunnel=* & highway=* & maxspeed=* { set tempnametunnel='(${maxspeed} kmh) ${tempnametunnel}' }
end 
tunnel=* & highway=* & lanes=* { set tempnametunnel='(${lanes}l) ${tempnametunnel}' } 
tunnel=* & highway=* & ref=* { set tempnametunnel='(${ref}) ${tempnametunnel}' }
tunnel=* & highway=* & alt_name=* { set tempnametunnel='{${alt_name}} ${tempnametunnel}' }
tunnel=* & highway=* & name=* { set tempnametunnel='${name} ${tempnametunnel}' }	#last addition (left most) is name

#tunnel=* & {name '(one_way)'} [0x1050e resolution 24 continue] #arrows
tunnel=* & highway=* {name '${tempnametunnel}' ; addlabel '${maxspeed} ${lanes}' | '${maxspeed}' | '${lanes}'} [0x10101 resolution 22 continue with_actions]


# Hide proposed ways
# highway=proposed | highway=proposal | highway=planned | highway~'.*proposed.*' {delete highway; delete junction}
# Hide removed ways
# highway=razed | highway=dismantled | highway=disused | highway=demolished {delete highway; delete junction}
# Hide abandoned ways. Abandoned highways have some evidence of their former existence but are no longer used. These
# abandoned highways could be useful in topographical maps.
# https://wiki.openstreetmap.org/wiki/Key:abandoned:
# (abandoned:highway=* & (highway!=* | highway=yes)) | highway=abandoned {delete highway; delete junction}
# Hide other non-existent ways
# highway=unbuilt | highway=neverbuilt | highway=rejected | highway~'x-.*' {delete highway; delete junction}

# Remove highway tag from ways which are not suitable for routing
highway=traffic_signals | highway=junction | highway=island | highway=centre_line | highway=traffic_island | highway=stopline |
highway=bus_stop | highway=bus_guideway | highway=emergency_access_point | highway=ohm:military:Trench
	{delete highway}
#highway=via_ferrata {delete highway} # this shouldn't show as routable on default map: path only for specialists
#highway=piste | highway=ski {delete highway}
highway=no | highway=none {delete highway}

# Disable dead-end-checks for unaccessible oneways
highway=* & oneway=yes & (access=private | access=no) {add mkgmap:dead-end-check=false}
# Validation-like checks (uncomment to enable)
#highway=motorway_link & oneway!=yes & (oneway!=no & oneway=*) {echo "motorway_link lacks oneway"}
highway=motorway | highway=motorway_link {add oneway=yes; add mkgmap:numbers=false}

# start of rules for process-exits and process-destination options
# which may add info to a part of these highway=*_link roads:
# motorway_link, trunk_link, primary_link, secondary_link, tertiary_link
# build destination hint
mkgmap:dest_hint=* {
 set tmp:dest_hint='${destination:ref|subst: =>} ${mkgmap:dest_hint|subst:;=> |subst:/=> }' |
 '${ref|subst: =>} ${mkgmap:dest_hint|subst:;=> |subst:/=> }' |
 '${mkgmap:dest_hint|subst:;=> |subst:/=> }';
 }
# build exit hint
mkgmap:exit_hint=true {
 set tmp:exit_hint='Exit ${mkgmap:exit_hint_ref} ${mkgmap:exit_hint_name}' |
 'Exit ${mkgmap:exit_hint_ref} ${mkgmap:exit_hint_exit_to}' |
 'Exit ${mkgmap:exit_hint_exit_to}' |
 'Exit ${mkgmap:exit_hint_name}' |
 'Exit ${mkgmap:exit_hint_ref}';
 }
# use destination hint and/or exit hint to build name
mkgmap:exit_hint=true | mkgmap:dest_hint=* {name '${tmp:exit_hint} ${tmp:dest_hint}' | '${tmp:dest_hint}' | '${tmp:exit_hint}'}
# end of rules for process-exits and process-destination options

# Flag paved roads
highway=* & (surface=asphalt | surface=paved | surface=sett |
 surface=concrete | surface=concrete:lanes | surface=concrete:plates |
 surface=paving_stones | surface=cobblestone |
 surface=cobblestone:flattened | surface=metal | surface=wood | surface=chipseal)
 {set mkgmap:unpaved=0 }
 #{set mkgmap:unpaved=0 ; name '${name} (pav)' | '(pav)' }
highway=* & tracktype=grade1 & surface!=* {set mkgmap:unpaved=0}

# Flag unpaved roads.
highway=* & mkgmap:unpaved!=0 & (
 surface=* |
 mtb:scale=* |
 tracktype~'grade[2-6]')
 {add mkgmap:unpaved=1}
	#{add mkgmap:unpaved=1 ; name '${name} (unp)' | '(unp)' }
highway=* & (
 mtb:scale~'[2-6].' |
 sac_scale~'.*(mountain|alpine)_hiking' |
 sport=via_ferrata)
 {set mkgmap:unpaved=1}
	#{set mkgmap:unpaved=1 ; name '${name} (unp)' | '(unp)'}
(highway=bridleway | highway=path | highway=track) & mkgmap:unpaved!=0 {add mkgmap:unpaved=1 }
(highway=unsurfaced | highway=via_ferrata) {set mkgmap:unpaved=1}

highway=* & mkgmap:unpaved!=1 & smoothness~'.*(bad|horrible|impassable)' {add mkgmap:road-speed=-2}

# Good ways without relation
highway=* & mkgmap:fast_road!=* & (int_ref=* | network=e-road | network=AH | network=TAH | network=US:I | network=US:US)
 {add mkgmap:fast_road=yes}
# Not best for car routing
highway=* & (access=hov | hov=designated | oneway=reversible)
 {set mkgmap:road-class=-2; set mkgmap:road-speed=-2; delete mkgmap:fast_road}

# convert some specific to generic with restrictions (platform is in a bus station)
#highway=steps | highway=corridor | highway=stepping_stones | highway=elevator | highway=escalator | highway=platform
 #{set highway=footway; add bicycle=no}
# virtual seems to be a way across a pedestrian area
highway=crossing | highway=virtual
 {set highway=path} # following logic may change

# Convert generic path to most specific
highway=path & (designation=permissive_bridleway | designation=public_bridleway)
 {set highway=bridleway; add foot=yes}
highway=path & (designation=permissive_footpath | designation=public_footpath)
 {set highway=footway; add foot=designated}
highway=path & snowplowing!=no & (bicycle=designated | bicycle=permissive | bicycle=official | cycleway=lane)
 {set highway=cycleway; add foot=yes}
#highway=path & foot=designated
# {set highway=footway}

leisure=track & area!=yes 
	{name '${name} (${athletics}) (${surface}) (${sport}) [track]' | '${name} (${surface}) (${sport}) [track]' | '${name} (${athletics}) (${sport}) [track]' | '${name} (${sport}) [track]' | '${name} (${athletics}) (${surface}) [track]' | '${name} (${surface}) [track]' | '${name} (${athletics}) [track]' | '${name} [track]' | '(${athletics}) (${surface}) (${sport}) [track]' | '(${surface}) (${sport}) [track]' | '(${athletics}) (${sport}) [track]' | '(${sport}) [track]' | '(${athletics}) (${surface}) [track]' | '(${surface}) [track]' | '(${athletics}) [track]' | '[track]' ; 
	addlabel '${phone}' | '${website}' | '${operator}'} 
	[0x10705 resolution 22-24]
(man_made=pier | man_made=quay | man_made=groyn) & lit=yes 
	{name '${name} (lit) (${surface}) [pier]' | '${name} (lit) [pier]' | '(lit) (${surface}) [pier]' | '(lit) [pier]' ; 
	addlabel '${phone}' | '${website}' | '${operator}'} [0x28 resolution 24]# might also have natural=water
man_made=pier | man_made=quay | man_made=groyn 
	{name '${name} (${surface}) [pier]' | '${name} [pier]' | '(${surface}) [pier]' | '[pier]' ; 
	addlabel '${phone}' | '${website}' | '${operator}'} [0x28 resolution 24]# might also have natural=water
man_made=storage_tank & content!=water 
	{name '${name} (${content}) [storage_tank]' | '(${content}) [storage_tank]' | '[storage_tank]' ; addlabel '${phone}' | '${website}' | '${operator}'} 
	[0x28 resolution 24]
dock=drydock | waterway=dock {add highway=footway; name '${ref} ${name} [drydock]' | '${ref} [drydock]' | '${name} [drydock]' | '[drydock]' ; addlabel '${phone}' | '${website}' | '${operator}'} [0x10705 resolution 24]

#sport=horse_racing | leisure=horse_riding {add name='${horse_raising|subst:"_=> "}'} [0x10705 resolution 24 default_name 'horse_racing']
sport=horse_racing | leisure=horse_riding {name '${name} [horse_racing]' | '[horse_racing]' ; addlabel '${phone}' | '${website}' | '${operator}'} [0x10705 resolution 24]

man_made=breakwater & is_closed()=false & mkgmap:mp_created!=true 
	{name '${name} [breakwater]' | '[breakwater]' ; addlabel '${phone}' | '${website}' | '${operator}'} [0x17 resolution 22-24] #rompe olas

# Roundabouts
junction=roundabout & (highway=trunk | highway=trunk_link) [0x0c road_class=4 road_speed=2 resolution 24 continue]
junction=roundabout & (highway=trunk | highway=trunk_link) [0x10801 resolution 17]

junction=roundabout & (highway=primary | highway=primary_link) & mkgmap:fast_road=yes [0x0c road_class=4 road_speed=2 resolution 24 continue]
junction=roundabout & (highway=primary | highway=primary_link) & mkgmap:fast_road=yes [0x10802 resolution 19]

junction=roundabout & (highway=primary | highway=primary_link) [0x0c road_class=3 road_speed=2 resolution 24 continue]
junction=roundabout & (highway=primary | highway=primary_link) [0x10802 resolution 19]

junction=roundabout & (highway=secondary | highway=secondary_link) & mkgmap:fast_road=yes [0x0c road_class=3 road_speed=2 resolution 24 continue]
junction=roundabout & (highway=secondary | highway=secondary_link) & mkgmap:fast_road=yes [0x10803 resolution 20-24]

junction=roundabout & (highway=secondary | highway=secondary_link) [0x0c road_class=2 road_speed=2 resolution 24 continue]
junction=roundabout & (highway=secondary | highway=secondary_link) [0x10803 resolution 20-24]

junction=roundabout & (highway=tertiary | highway=tertiary_link) [0x0c road_class=1 road_speed=1 resolution 24 continue]
junction=roundabout & (highway=tertiary | highway=tertiary_link) [0x10804 resolution 21]

junction=roundabout & (highway=unclassified | highway=minor) [0x0c road_class=1 road_speed=1 resolution 21]
junction=roundabout & highway=* [0x0c road_class=0 road_speed=1 resolution 22-24]

# Ways that may or may not be useable


# Lower the road speed of ways under some construction.
highway=* & construction=* & maxspeed!=* {add mkgmap:road-speed='-1'} 
# Lower the road speed of disused ways.
highway=* & disused=yes & maxspeed!=* {add mkgmap:road-speed='-2'}

#Tunnel narrow : just visual no routing
highway ~'(path|footway|bridleway|track|cycleway|steps)' &
	!(piste:type = * | building = * | service = parking_aisle | attraction = water_slide) &
	!(area = yes | jbmhighwayinpedestrian = true)
	{name '${name} [tunnel]'}
	[0x24 resolution 24 continue]

highway=yes {set highway=footway} # fix common bad tagging - little bits of path to join other routable ways

# Some countries allow, others disallow bicycling on pedestrian streets. See inc/access_country


highway=driveway {set highway=service; add service=driveway} # fix common bad taggi
highway=access {set highway=service} # fix common bad tagging
highway=access_ramp {set highway=footway} # proposed


#non default name for highway
surface=unpaved { set surface='unp' }			# used for shorter name
surface=compacted { set surface='compac' }		# used for shorter name
highway=primary_link { set highway='p_link' }	# used for shorter name
highway=secondary_link { set highway='s_link' }	# used for shorter name
highway=tertiary_link { set highway='t_link' }	# used for shorter name
highway=unclassified { set highway='unclass' }	# used for shorter name
highway=residential { set highway='resid' }		# used for shorter name

highway=service & service=* { set tempnamehighway='[${service}]' }
highway=* & vehicle=no { set tempnamehighway='[no vehicle]' }
highway=* & motor_vehicle=no { set tempnamehighway='[no motor vehicle]' }
man_made=embankment | man_made=levee { set tempnamehighway='[embank]' }

#default for highway
highway=* & tempnamehighway!=* & service!=* { set tempnamehighway='[${highway}]' }

#extras
#highway=* & oneway!=no & oneway=* { set tempnamehighway='(one_way) ${tempnamehighway}' }
highway=* & oneway=no { set tempnamehighway='(two_way) ${tempnamehighway}' }
highway=* & surface=* { set tempnamehighway='<${surface}> ${tempnamehighway}' }
highway=* & surface!=* { set tempnamehighway='<unkn> ${tempnamehighway}' } 
highway=* & tracktype=* { set tempnamehighway='(${tracktype}) ${tempnamehighway}' }
highway=* & smoothness=* { set tempnamehighway='(${smoothness}) ${tempnamehighway}' }
highway=* & horse=* { set tempnamehighway='(horse ${horse}) ${tempnamehighway}' }
highway=* & highway!=cycleway & bicycle=* { set tempnamehighway='(cycle ${bicycle}) ${tempnamehighway}' }
highway=* & highway!=cycleway & cycleway=* { set tempnamehighway='(cycle ${cycleway}) ${tempnamehighway}' }
highway=* & highway!=footway & foot=* { set tempnamehighway='(foot ${foot}) ${tempnamehighway}' }
highway=* & mtb:scale=* { set tempnamehighway='(mtb ${mtb:scale}) ${tempnamehighway}' }
highway=* & width=* { set tempnamehighway='(${width}m) ${tempnamehighway}' }
highway=* & lanes=* { set tempnamehighway='(${lanes}l) ${tempnamehighway}' }
if ( highway=* & maxspeed=* & maxspeed ~ '.*mph' ) then
	highway=* & maxspeed=* { set tempnamehighway='(${maxspeed}) ${tempnamehighway}' }
else
	highway=* & maxspeed=* { set tempnamehighway='(${maxspeed} kmh) ${tempnamehighway}' }
end 

highway=* & alt_name=* { set tempnamehighway='{${alt_name}} ${tempnamehighway}' }
highway=* & name=* { set tempnamehighway='${name} ${tempnamehighway}' }	#last addition (left most) is name

highway=* & oneway=yes {name '(one_way)'} [0x1050e resolution 24 continue] #arrows 0x1050e

# Ways sorted roughly by descending order of class


highway=motorway & mkgmap:fast_road=yes {name '${ref|highway-symbol:shield}' ; addlabel '${tempnamehighway}' ; addlabel '${maxspeed} ${lanes}' | '${maxspeed}' | '${lanes}'} 
	[0x01 road_class=4 road_speed=7 resolution 14]
highway=motorway {name '${ref|highway-symbol:shield}' ; addlabel '${tempnamehighway}' ; addlabel '${maxspeed} ${lanes}' | '${maxspeed}' | '${lanes}'} 
	[0x01 road_class=4 road_speed=7 resolution 15]
	
highway=motorway_link & (mkgmap:exit_hint=true | mkgmap:dest_hint=*) 
	{name '${ref|highway-symbol:shield}' ; addlabel '${tempnamehighway}' ; addlabel '${maxspeed} ${lanes}' | '${maxspeed}' | '${lanes}'} [0x0b road_class=4 road_speed=2 resolution 20]
highway=motorway_link {name '${ref|highway-symbol:shield}' ; addlabel '${tempnamehighway}' ; addlabel '${maxspeed} ${lanes}' | '${maxspeed}' | '${lanes}'} 
	[0x09 road_class=4 road_speed=2 resolution 20]

highway=* & ref=* { set ref='${ref|substring:0:7}' }	# Shields fail when its too long
highway=trunk & mkgmap:fast_road=yes {name '${ref|highway-symbol:round}' ; addlabel '${tempnamehighway}' ; addlabel '${maxspeed} ${lanes}' | '${maxspeed}' | '${lanes}'} 
	[0x02 road_class=4 road_speed=5 resolution 15]
highway=trunk {name '${ref|highway-symbol:round}' ; addlabel '${tempnamehighway}' ; addlabel '${maxspeed} ${lanes}' | '${maxspeed}' | '${lanes}'} [0x02 road_class=4 road_speed=5 resolution 18]

highway=trunk_link & (mkgmap:exit_hint=true | mkgmap:dest_hint=*) {name '${ref|highway-symbol:round}' ; addlabel '${tempnamehighway}' ; addlabel '${maxspeed} ${lanes}' | '${maxspeed}' | '${lanes}'}
	[0x0b road_class=4 road_speed=2 resolution 20]
highway=trunk_link {name '${ref|highway-symbol:round}' ; addlabel '${tempnamehighway}' ; addlabel '${maxspeed} ${lanes}' | '${maxspeed}' | '${lanes}'} [0x09 road_class=4 road_speed=2 resolution 20]
highway=* & motorroad=yes {name '${ref|highway-symbol:round}' ; addlabel '${tempnamehighway}' ; addlabel '${maxspeed} ${lanes}' | '${maxspeed}' | '${lanes}'} 
	[0x02 road_class=4 road_speed=4 resolution 18]

highway=primary & mkgmap:fast_road=yes {name '${ref|highway-symbol:hbox}' ; addlabel '${tempnamehighway}' ; addlabel '${maxspeed} ${lanes}' | '${maxspeed}' | '${lanes}'} 
	[0x03 road_class=4 road_speed=4 resolution 17]
highway=primary {name '${ref|highway-symbol:hbox}' ; addlabel '${tempnamehighway}' ; addlabel '${maxspeed} ${lanes}' | '${maxspeed}' | '${lanes}'} 
	[0x03 road_class=3 road_speed=4 resolution 19]
	
highway=primary_link & (mkgmap:exit_hint=true | mkgmap:dest_hint=*) & mkgmap:fast_road=yes 
	{name '${ref|highway-symbol:hbox}' ; addlabel '${tempnamehighway}' ; addlabel '${maxspeed} ${lanes}' | '${maxspeed}' | '${lanes}'} [0x0b road_class=4 road_speed=1 resolution 21]
highway=p_link & (mkgmap:exit_hint=true | mkgmap:dest_hint=*) {name '${ref|highway-symbol:hbox}' ; addlabel '${tempnamehighway}' ; addlabel '${maxspeed} ${lanes}' | '${maxspeed}' | '${lanes}'} 
